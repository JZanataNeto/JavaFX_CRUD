<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fillWidth="false" prefHeight="300.0" prefWidth="250.0" spacing="30.0" style="-fx-background-color: #ff921c;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joaozanata.javafx_crud.LoginController">
   <children>
      <Label fx:id="loginText" alignment="CENTER" text="Login" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font size="20.0" />
         </font>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <VBox.margin>
            <Insets left="80.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="campoNome" promptText="nome">
         <VBox.margin>
            <Insets left="35.0" />
         </VBox.margin>
         <font>
            <Font size="13.0" />
         </font>
      </TextField>
      <PasswordField fx:id="campoSenha" promptText="senha">
         <VBox.margin>
            <Insets left="35.0" />
         </VBox.margin>
         <font>
            <Font size="13.0" />
         </font>
      </PasswordField>
      <Button fx:id="btnEntrar" mnemonicParsing="false" onAction="#handleBotaoEntrar" style="-fx-background-color: #eca427; -fx-border-color: #fff;" text="Entrar" textFill="WHITE">
         <VBox.margin>
            <Insets left="80.0" />
         </VBox.margin>
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
